# ==============================================================================
# K-POP / J-POP RANKINGS LEAGUE — ENVIRONMENT VARIABLES
# ==============================================================================

# Application Branding
APP_DISPLAY_NAME="Fan Choice Most Populars"
PORT=3001
# npm run dev sirve interfaz y API juntas en http://localhost:3000
# VITE_API_BASE_URL solo si la API está en otro dominio; no es la URL de Spotify Duo.
# VITE_API_BASE_URL=https://tu-api-de-la-liga.example/api/v1
NODE_ENV=development

# Canonical Timezone (Crucial for daily ballot cutoffs)
LEAGUE_TIMEZONE=America/Panama

# Database (PostgreSQL - Supabase or Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rankings_league?sslmode=disable

# Authentication Secrets
JWT_SECRET=super_secret_cryptographic_jwt_key_at_least_32_bytes_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=secure_cookie_signing_secret_random_bytes

# Authorized Competitor Names (Configurable, never hardcoded)
PARTICIPANT_1_NAME="Alex"
PARTICIPANT_1_USERNAME="alex"
PARTICIPANT_2_NAME="Sam"
PARTICIPANT_2_USERNAME="sam"

# External Integration: Spotify Duo Charts (Read-Only)
# Set to 'true' to use the offline MockListeningDataProvider during development
USE_MOCK_LISTENING_DATA=false
SPOTIFY_DUO_CHARTS_API_URL=https://spotify-duo-charts-production.up.railway.app
SPOTIFY_DUO_CHARTS_API_SECRET=your_read_only_integration_token_here

# Daily Scoring Bonus Thresholds (JSON array of stream thresholds)
# [{ "minStreams": 1, "maxStreams": 2, "bonus": 1 }, { "minStreams": 3, "maxStreams": 5, "bonus": 2 }, ...]
STREAM_BONUS_TIERS_CONFIG='[{"min":1,"max":2,"bonus":1},{"min":3,"max":5,"bonus":2},{"min":6,"max":9,"bonus":3},{"min":10,"max":15,"bonus":4},{"min":16,"max":null,"bonus":5}]'
